# Server Port
PORT=8080

# PostgreSQL Connection String (Railway, Supabase, Neon, or Local Postgres)
DATABASE_URL=postgresql://postgres:password@localhost:5432/laundry_db
# Or alternatively:
# SPRING_DATASOURCE_URL=postgresql://postgres:password@localhost:5432/laundry_db

# Allowed CORS Origins (comma-separated, or * for all)
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# JWT Authentication Configuration
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars
JWT_EXPIRATION_MS=86400000

# Environment Mode
NODE_ENV=development
